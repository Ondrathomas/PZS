import os
import numpy as np
import pandas as pd
from scipy.io import wavfile

# Cesta ke složce
cesta = r"C:\Users\ondra\OneDrive\Plocha\voice-icar-federico-ii-database-1.0.0"

vysledky = []

# Procházení všech souborů ve složce a podsložkách
for dirpath, dirnames, filenames in os.walk(cesta):
    for soubor in filenames:
        file_path = os.path.join(dirpath, soubor)
        try:
            if soubor.endswith(".wav"):
                vzorkovaci_frekvence, signal = wavfile.read(file_path)
                signal = signal.astype(float)
                
                prumer = np.mean(signal)
                odchylka = np.std(signal)
                max_hodnota = np.max(np.abs(signal))

                stav = "Patologický" if np.mean(np.abs(signal)) > 5000 or max_hodnota > 20000 else "Dobrý"

                vysledky.append({
                    "Soubor": soubor,
                    "Typ": "WAV",
                    "Hodnota": prumer,
                    "Směrodatná odchylka": odchylka,
                    "Max_amplituda": max_hodnota,
                    "Klasifikace": stav
                })

            elif soubor.endswith(".txt") or soubor.endswith(".hea"):
                with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
                    obsah = f.read()
                delka = len(obsah)
                
                stav = "Patologický" if delka > 10000 else "Dobrý"

                vysledky.append({
                    "Soubor": soubor,
                    "Typ": "TXT/HEA",
                    "Hodnota": delka,
                    "Směrodatná odchylka": None,
                    "Max_amplituda": None,
                    "Klasifikace": stav
                })
        except Exception as e:
            print(f"Chyba při načítání {soubor}: {e}")

# Vytvoření DataFrame df_raw
df_raw = pd.DataFrame(vysledky).reset_index(drop=True)

# Shrnutí pro Data Wrangler
shrnutí = df_raw.groupby("Klasifikace").agg(
    **{
        "Počet vzorků": ("Soubor", "count"),
        "Průměr": ("Hodnota", "mean"),
        "Směr. odch.": ("Hodnota", "std")
    }
).reset_index()

print("\n===== Shrnutí výsledků =====")
print(shrnutí)

# Volitelně: zobrazení rozdělení
dobre = df_raw[df_raw["Klasifikace"] == "Dobrý"]
patologicke = df_raw[df_raw["Klasifikace"] == "Patologický"]

print("\n===== DOBRÉ SIGNÁLY =====")
print(dobre)

print("\n===== PATOLOGICKÉ SIGNÁLY =====")
print(patologicke)
